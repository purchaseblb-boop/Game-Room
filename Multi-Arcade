<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🎮 Game Hub</title>
    <style>
        /* ─── Reset & Base ─── */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html,
        body {
            width: 100%;
            height: 100%;
            background: #0b0e14;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #f0f0f0;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* ─── Layout ─── */
        .app {
            display: flex;
            flex-direction: column;
            height: 100vh;
            max-height: 100dvh;
            background: #0b0e14;
        }

        /* ─── Header ─── */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            padding: 10px 18px;
            background: #141a24;
            border-bottom: 1px solid #2a3342;
            z-index: 10;
            gap: 10px;
            flex-wrap: wrap;
        }
        .header h1 {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, #f7b731, #f5a623);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.3px;
            white-space: nowrap;
        }
        .header h1 span {
            font-weight: 300;
            background: none;
            -webkit-text-fill-color: #6a7a8e;
            color: #6a7a8e;
        }

        .nav-scroll {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding: 2px 0 6px;
            flex: 1 1 auto;
            min-width: 0;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .nav-scroll::-webkit-scrollbar {
            display: none;
        }

        .nav-btn {
            flex: 0 0 auto;
            padding: 7px 16px;
            border: none;
            border-radius: 40px;
            background: #1f2937;
            color: #b0c0d0;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.2px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
        }
        .nav-btn:hover {
            background: #2a3648;
            color: #fff;
            transform: translateY(-1px);
        }
        .nav-btn:active {
            transform: scale(0.96);
        }
        .nav-btn.active {
            background: #f5a623;
            color: #0b0e14;
            box-shadow: 0 0 20px rgba(245, 166, 35, 0.3);
        }
        .nav-btn .icon {
            font-size: 18px;
            line-height: 1;
        }

        /* ─── Game Container ─── */
        .game-container {
            flex: 1 1 auto;
            position: relative;
            background: #0b0e14;
            overflow: hidden;
            min-height: 0;
        }
        .game-container iframe {
            display: block;
            width: 100%;
            height: 100%;
            border: none;
            background: #0b0e14;
        }

        /* ─── Fallback / Loading ─── */
        .fallback {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #4a5a6e;
            text-align: center;
            padding: 30px;
        }
        .fallback .big-icon {
            font-size: 64px;
            margin-bottom: 16px;
            opacity: 0.5;
        }
        .fallback h2 {
            font-weight: 300;
            font-size: 22px;
            color: #6a7a8e;
        }
        .fallback p {
            font-size: 14px;
            color: #3a4a5e;
            margin-top: 6px;
        }

        /* ─── Responsive ─── */
        @media (max-width: 700px) {
            .header {
                padding: 8px 12px;
                gap: 6px;
            }
            .header h1 {
                font-size: 16px;
            }
            .nav-btn {
                font-size: 12px;
                padding: 5px 12px;
            }
            .nav-btn .icon {
                font-size: 15px;
            }
        }
        @media (max-width: 480px) {
            .header h1 {
                font-size: 14px;
            }
            .nav-btn {
                font-size: 11px;
                padding: 4px 10px;
            }
        }
    </style>
</head>
<body>

    <div class="app">

        <!-- ─── HEADER ─── -->
        <header class="header">
            <h1>🎮 Game<span>Hub</span></h1>
            <nav class="nav-scroll" id="navScroll">
                <button class="nav-btn active" data-game="chess">
                    <span class="icon">♟</span> Chess
                </button>
                <button class="nav-btn" data-game="dino">
                    <span class="icon">🦖</span> Dino Run
                </button>
                <button class="nav-btn" data-game="flappy">
                    <span class="icon">🐦</span> Flappy
                </button>
                <button class="nav-btn" data-game="geometry">
                    <span class="icon">⬛</span> Geometry
                </button>
                <button class="nav-btn" data-game="tictac">
                    <span class="icon">⭕</span> Tic-Tac-Toe
                </button>
            </nav>
        </header>

        <!-- ─── GAME CONTAINER ─── -->
        <div class="game-container" id="gameContainer">
            <iframe id="gameFrame" sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-popups"></iframe>
        </div>

    </div>

    <script>
        (function() {
            'use strict';

            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            //  1.  GAME HTML — paste your full HTML here
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

            const GAMES = {

                // ─── CHESS ──────────────────────────────────
                chess: `//// PUT YOUR CHESS HTML HERE ////
        <!DOCTYPE html>
        <html>
        <head><title>Chess 247</title></head>
        <body style="margin:0;background:#1a1a2e;display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#fff;flex-direction:column;">
            <h2 style="color:#f5a623;">♟ Chess 247</h2>
            <p style="color:#8a9aaa;max-width:400px;text-align:center;font-size:15px;">
                The full Chess 247 game is too large to embed inline.<br>
                <span style="color:#f5a623;">👇</span>
            </p>
            <a href="https://www.247chess.com/" target="_blank"
               style="display:inline-block;margin-top:18px;padding:14px 40px;background:#f5a623;color:#0b0e14;border-radius:60px;text-decoration:none;font-weight:700;font-size:18px;box-shadow:0 4px 24px rgba(245,166,35,0.3);transition:transform 0.2s;">
                Play Chess Online →
            </a>
            <p style="color:#4a5a6e;font-size:12px;margin-top:30px;">
                Paste your Chess 247 HTML into the <code>chess</code> field above.
            </p>
        </body>
        </html>
        //// END CHESS HTML ////
        `,

                // ─── DINO RUN ──────────────────────────────
                dino: `//// PUT YOUR DINO RUN HTML HERE ////
        <!DOCTYPE html>
        <html lang="en">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Dino Runner</title>
            <style>
                :root { --bg: #f7f7f7; }
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body {
                    background: #1a1a2e;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    min-height: 100vh;
                    font-family: 'Courier New', monospace;
                    overflow: hidden;
                    touch-action: manipulation;
                    -webkit-tap-highlight-color: transparent;
                    user-select: none;
                    -webkit-user-select: none;
                }
                .game-wrapper {
                    position: relative;
                    width: 95vw;
                    max-width: 900px;
                    aspect-ratio: 900 / 224;
                    border-radius: 8px;
                    overflow: hidden;
                    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
                    background: #f7f7f7;
                    transition: background-color 0.5s ease;
                }
                .game-wrapper.night { background: #1a1a2e; }
                canvas {
                    display: block;
                    width: 100%;
                    height: 100%;
                    image-rendering: auto;
                    cursor: pointer;
                }
                .instructions {
                    position: absolute;
                    bottom: 12px;
                    left: 50%;
                    transform: translateX(-50%);
                    color: #888;
                    font-size: 11px;
                    letter-spacing: 1px;
                    pointer-events: none;
                    transition: opacity 0.3s;
                }
                .game-wrapper.night .instructions { color: #aaa; }
                @media (max-width:500px) {
                    .game-wrapper { width: 98vw; border-radius:4px; }
                    .instructions { font-size:9px; bottom:8px; }
                }
            </style>
        </head>
        <body>
            <div class="game-wrapper" id="gameWrapper">
                <canvas id="gameCanvas" width="900" height="224"></canvas>
                <div class="instructions" id="instructions">PRESS SPACE OR TAP TO START</div>
            </div>
            <script>
                (function() {
                    const canvas = document.getElementById('gameCanvas');
                    const ctx = canvas.getContext('2d');
                    const wrapper = document.getElementById('gameWrapper');
                    const instructionsEl = document.getElementById('instructions');
                    const W = 900,
                        H = 224;
                    const GROUND_Y = 180,
                        GROUND_HEIGHT = 44;
                    const DINO_X = 60;
                    const GRAVITY = 2800,
                        JUMP_VELOCITY = -750,
                        DUCK_GRAVITY_MULTIPLIER = 2.5;
                    const BASE_SPEED = 380,
                        MAX_SPEED = 1100,
                        SPEED_INCREMENT = 0.8;
                    const DAY_NIGHT_THRESHOLD = 700;
                    const OBSTACLE_SPAWN_MIN_GAP = 350,
                        OBSTACLE_SPAWN_MAX_GAP = 900;
                    const STATE = { IDLE: 'idle', PLAYING: 'playing', GAME_OVER: 'gameOver' };
                    let gameState = STATE.IDLE;
                    let score = 0,
                        highScore = 0,
                        gameSpeed = BASE_SPEED,
                        totalDistance = 0,
                        isNight = false,
                        lastDayNightScore = 0,
                        frameCount = 0,
                        gameOverBlinkTimer = 0,
                        showGameOverText = true;
                    let obstacleSpawnTimer = 0,
                        nextObstacleSpawnAt = 0;

                    try {
                        const saved = localStorage.getItem('dinoRunnerHighScore');
                        if (saved !== null) highScore = parseInt(saved, 10) || 0;
                    } catch (e) { highScore = 0; }

                    function seededRandom(seed) { let s = seed | 0;
                        s = (s ^ 61) ^ (s >>> 16);
                        s = s + (s << 3);
                        s = s ^ (s >>> 4);
                        s = Math.imul(s, 0x27d4eb2d);
                        s = s ^ (s >>> 15);
                        return (s >>> 0) / 4294967296; }

                    function clamp(val, min, max) { return Math.max(min, Math.min(max, val)); }

                    function rectsCollide(a, b) {
                        return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
                    }

                    class Dino {
                        constructor() {
                            this.x = DINO_X;
                            this.y = GROUND_Y;
                            this.widthStanding = 44;
                            this.heightStanding = 46;
                            this.widthDucking = 56;
                            this.heightDucking = 26;
                            this.velocityY = 0;
                            this.isJumping = false;
                            this.isDucking = false;
                            this.isGrounded = true;
                            this.runFrame = 0;
                            this.runFrameTimer = 0;
                            this.runFrameInterval = 0.08;
                            this.blinkTimer = 0;
                            this.blinkInterval = 2.5;
                            this.isBlinking = false;
                            this.blinkDuration = 0.08;
                            this.invincibleTimer = 0;
                        }
                        getHitbox() {
                            const m = 6;
                            if (this.isDucking) {
                                return { x: this.x + m, y: this.y - this.heightDucking + m, w: this.widthDucking - m * 2,
                                    h: this.heightDucking - m };
                            }
                            return { x: this.x + m, y: this.y - this.heightStanding + m, w: this.widthStanding - m * 2,
                                h: this.heightStanding - m };
                        }
                        jump() {
                            if (this.isGrounded && !this.isDucking) {
                                this.velocityY = JUMP_VELOCITY;
                                this.isJumping = true;
                                this.isGrounded = false;
                            }
                        }
                        duck(shouldDuck) {
                            if (shouldDuck && this.isGrounded && !this.isJumping) {
                                this.isDucking = true;
                            } else if (!shouldDuck) {
                                this.isDucking = false;
                            }
                            if (shouldDuck && !this.isGrounded) {
                                this.velocityY += GRAVITY * DUCK_GRAVITY_MULTIPLIER * 0.016;
                            }
                        }
                        update(dt) {
                            const cdt = Math.min(dt, 0.1);
                            if (!this.isGrounded) {
                                this.velocityY += GRAVITY * cdt;
                                this.y += this.velocityY * cdt;
                                if (this.y >= GROUND_Y) {
                                    this.y = GROUND_Y;
                                    this.velocityY = 0;
                                    this.isGrounded = true;
                                    this.isJumping = false;
                                    this.invincibleTimer = 0.05;
                                }
                            }
                            if (this.isDucking && !this.isGrounded) {
                                this.velocityY += GRAVITY * (DUCK_GRAVITY_MULTIPLIER - 1) * cdt;
                            }
                            if (this.isDucking && this.isGrounded && this.y === GROUND_Y) {
                                this.isJumping = false;
                                this.velocityY = 0;
                            }
                            if (this.y > GROUND_Y) {
                                this.y = GROUND_Y;
                                this.velocityY = 0;
                                this.isGrounded = true;
                                this.isJumping = false;
                            }
                            if (gameState === STATE.PLAYING && this.isGrounded && !this.isDucking) {
                                this.runFrameTimer += cdt;
                                if (this.runFrameTimer >= this.runFrameInterval) {
                                    this.runFrameTimer -= this.runFrameInterval;
                                    this.runFrame = 1 - this.runFrame;
                                }
                            } else if (this.isGrounded && gameState === STATE.IDLE) {
                                this.runFrame = 0;
                                this.runFrameTimer = 0;
                            }
                            if (!this.isBlinking) {
                                this.blinkTimer += cdt;
                                if (this.blinkTimer >= this.blinkInterval) {
                                    this.blinkTimer -= this.blinkInterval;
                                    this.isBlinking = true;
                                }
                            } else {
                                this.blinkTimer += cdt;
                                if (this.blinkTimer >= this.blinkDuration) {
                                    this.blinkTimer -= this.blinkDuration;
                                    this.isBlinking = false;
                                    this.blinkTimer = 0;
                                }
                            }
                            if (this.invincibleTimer > 0) this.invincibleTimer -= cdt;
                        }
                        draw(ctx, nightMode) {
                            ctx.save();
                            const bc = nightMode ? '#e0e0e0' : '#535353';
                            const dc = nightMode ? '#c0c0c0' : '#2b2b2b';
                            const ec = nightMode ? '#1a1a2e' : '#ffffff';
                            const pc = nightMode ? '#ffffff' : '#000000';
                            if (this.isDucking) this.drawDucking(ctx, bc, dc, ec, pc);
                            else this.drawStanding(ctx, bc, dc, ec, pc);
                            ctx.restore();
                        }
                        drawStanding(ctx, bc, dc, ec, pc) {
                            const bx = this.x,
                                by = this.y,
                                s = 2;
                            const grid = [
                                '....................'.split(''),
                                '.....111111.........'.split(''),
                                '....11111111........'.split(''),
                                '....111111111.......'.split(''),
                                '...1111111111.......'.split(''),
                                '...11111111111......'.split(''),
                                '..111111111111......'.split(''),
                                '..1111111111111.....'.split(''),
                                '..11111111111111....'.split(''),
                                '.111111111111111....'.split(''),
                                '.111111111111111....'.split(''),
                                '1111111111111111....'.split(''),
                                '111111111111111.....'.split(''),
                                '11111111111111......'.split(''),
                                '1111111111111.......'.split(''),
                                '111111111111........'.split(''),
                                '1111111111..........'.split(''),
                                '1111111.......1.....'.split(''),
                                '111111........11....'.split(''),
                                '11111.........11....'.split(''),
                                '1111..........11....'.split(''),
                                '111...........11....'.split(''),
                                '11............11....'.split(''),
                            ];
                            const eyeRow = 4,
                                eyeCol1 = 11,
                                eyeCol2 = 12;
                            for (let row = 0; row < grid.length; row++) {
                                for (let col = 0; col < grid[row].length; col++) {
                                    const cell = grid[row][col];
                                    if (cell === '.') continue;
                                    const px = bx + col * s,
                                        py = by - (grid.length - row) * s;
                                    if (row === eyeRow && (col === eyeCol1 || col === eyeCol2)) {
                                        if (!this.isBlinking) {
                                            ctx.fillStyle = ec;
                                            ctx.fillRect(px, py, s, s);
                                            if (col === eyeCol2) {
                                                ctx.fillStyle = pc;
                                                ctx.fillRect(px + 1, py, 1, 1);
                                            }
                                        } else {
                                            ctx.fillStyle = bc;
                                            ctx.fillRect(px, py, s, s);
                                        }
                                    } else if (cell === '1') { ctx.fillStyle = bc;
                                        ctx.fillRect(px, py, s, s); } else if (cell === '2') { ctx.fillStyle = dc;
                                        ctx.fillRect(px, py, s, s); }
                                }
                            }
                            const lw = s * 3,
                                lh = s * 5,
                                ly = by - lh;
                            if (this.isGrounded && gameState === STATE.PLAYING && this.runFrame === 0) {
                                ctx.fillStyle = bc;
                                ctx.fillRect(bx + s * 2, ly, lw, lh);
                                ctx.fillStyle = dc;
                                ctx.fillRect(bx + s * 9, ly + s, lw, lh - s);
                            } else if (this.isGrounded && gameState === STATE.PLAYING && this.runFrame === 1) {
                                ctx.fillStyle = dc;
                                ctx.fillRect(bx + s * 2, ly + s, lw, lh - s);
                                ctx.fillStyle = bc;
                                ctx.fillRect(bx + s * 9, ly, lw, lh);
                            } else {
                                ctx.fillStyle = bc;
                                ctx.fillRect(bx + s * 2, ly, lw, lh);
                                ctx.fillStyle = dc;
                                ctx.fillRect(bx + s * 8, ly, lw, lh);
                            }
                            ctx.fillStyle = bc;
                            ctx.fillRect(bx + s * 13, by - s * 14, s * 2, s * 3);
                        }
                        drawDucking(ctx, bc, dc, ec, pc) {
                            const bx = this.x,
                                by = this.y,
                                s = 2;
                            const grid = [
                                '...........................'.split(''),
                                '.......11111111111........'.split(''),
                                '......1111111111111.......'.split(''),
                                '.....111111111111111......'.split(''),
                                '....11111111111111111.....'.split(''),
                                '...1111111111111111111....'.split(''),
                                '..11111111111111111111....'.split(''),
                                '.11111111111111111111.....'.split(''),
                                '11111111111111111111......'.split(''),
                                '111111111111111111........'.split(''),
                                '111111......111...........'.split(''),
                                '11111.......11............'.split(''),
                                '1111........11............'.split(''),
                            ];
                            for (let row = 0; row < grid.length; row++) {
                                for (let col = 0; col < grid[row].length; col++) {
                                    const cell = grid[row][col];
                                    if (cell === '.') continue;
                                    const px = bx + col * s,
                                        py = by - (grid.length - row) * s;
                                    ctx.fillStyle = bc;
                                    ctx.fillRect(px, py, s, s);
                                }
                            }
                            const eyeX = bx + s * 21,
                                eyeY = by - s * 8;
                            if (!this.isBlinking) {
                                ctx.fillStyle = ec;
                                ctx.fillRect(eyeX, eyeY, s * 2, s);
                                ctx.fillStyle = pc;
                                ctx.fillRect(eyeX + s, eyeY, s, s);
                            } else {
                                ctx.fillStyle = bc;
                                ctx.fillRect(eyeX, eyeY, s * 2, s);
                            }
                            ctx.fillStyle = bc;
                            ctx.fillRect(bx + s * 3, by - s * 4, s * 3, s * 4);
                            ctx.fillStyle = dc;
                            ctx.fillRect(bx + s * 14, by - s * 3, s * 3, s * 3);
                        }
                        reset() {
                            this.y = GROUND_Y;
                            this.velocityY = 0;
                            this.isJumping = false;
                            this.isDucking = false;
                            this.isGrounded = true;
                            this.runFrame = 0;
                            this.runFrameTimer = 0;
                            this.blinkTimer = Math.random() * 2;
                            this.isBlinking = false;
                            this.invincibleTimer = 0;
                        }
                    }

                    class Obstacle {
                        constructor(x, y, width, height, type) {
                            this.x = x;
                            this.y = y;
                            this.w = width;
                            this.h = height;
                            this.type = type;
                            this.passed = false;
                            this.frame = 0;
                            this.frameTimer = 0;
                            this.frameInterval = 0.25;
                        }
                        getHitbox() {
                            const m = this.type.includes('pterodactyl') ? 7 : 5;
                            return { x: this.x + m, y: this.y + m, w: this.w - m * 2, h: this.h - m };
                        }
                        update(dt, speed) {
                            this.x -= speed * dt;
                            if (this.type.includes('pterodactyl')) {
                                this.frameTimer += dt;
                                if (this.frameTimer >= this.frameInterval) {
                                    this.frameTimer -= this.frameInterval;
                                    this.frame = 1 - this.frame;
                                }
                            }
                        }
                        isOffScreen() { return this.x + this.w < -20; }
                        draw(ctx, nightMode) {
                            ctx.save();
                            const cc = nightMode ? '#8fbc8f' : '#4a7c3f';
                            const cd = nightMode ? '#6a9e6a' : '#2d5a1e';
                            const pc = nightMode ? '#c8c8c8' : '#535353';
                            const pw = nightMode ? '#a0a0a0' : '#3a3a3a';
                            if (this.type === 'cactus_small') this.drawCactus(ctx, this.x, this.y, this.w, this.h, false, cc,
                            cd);
                            else if (this.type === 'cactus_large') this.drawCactus(ctx, this.x, this.y, this.w, this.h, true,
                                cc, cd);
                            else if (this.type === 'cactus_group') this.drawCactusGroup(ctx, this.x, this.y, cc, cd);
                            else if (this.type.includes('pterodactyl')) this.drawPterodactyl(ctx, this.x, this.y, this.w,
                                this.h, pc, pw);
                            ctx.restore();
                        }
                        drawCactus(ctx, x, y, w, h, isLarge, color, darkColor) {
                            const s = 2;
                            const cols = Math.floor(w / s),
                                rows = Math.floor(h / s);
                            const cx = x,
                                cy = y;
                            ctx.fillStyle = color;
                            const tw = Math.floor(cols * 0.4),
