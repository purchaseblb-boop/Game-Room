            //  2.  GAME LOADER
            // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

            const frame = document.getElementById('gameFrame');
            const navBtns = document.querySelectorAll('.nav-btn');
            let currentGame = 'chess';

            function loadGame(gameId) {
                const html = GAMES[gameId] || GAMES.chess;
                // Clean up the placeholder markers
                let clean = html;
                // Remove the marker comments if they exist
                clean = clean.replace(/\/\/\/\/ PUT YOUR .*? HTML HERE \/\/\/\//g, '');
                clean = clean.replace(/\/\/\/\/ END .*? HTML \/\/\/\//g, '');

                // If the game HTML is actually a placeholder with a link, keep it
                // Otherwise, use blob URL
                try {
                    const blob = new Blob([clean], { type: 'text/html; charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    frame.src = url;
                    // Revoke old URL after a delay
                    setTimeout(() => { URL.revokeObjectURL(url); }, 5000);
                } catch (e) {
                    // Fallback: use data URI
                    frame.srcdoc = clean;
                }

                // Update active button
                navBtns.forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.game === gameId);
                });
                currentGame = gameId;
            }

            // ─── Navigation clicks ───
            navBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const id = this.dataset.game;
                    if (id && id !== currentGame) {
                        loadGame(id);
                    }
                });
                // Touch support
                btn.addEventListener('touchstart', function(e) {
                    // Just to improve mobile feel
                }, { passive: true });
            });

            // ─── Load default game ───
            loadGame('chess');

            // ─── Handle resize for iframe ───
            function handleResize() {
                // The iframe will resize with its container
            }
            window.addEventListener('resize', handleResize);

            console.log('🎮 Game Hub loaded! Select a game from the navigation bar.');
